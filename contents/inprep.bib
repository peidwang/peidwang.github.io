@article{wang_Antarctic_2026,
	title = {Antarctic Ozone Depletion Shapes Surface Cooling Pattern and Climate Sensitivity},
	abstract = {Changes in sea surface temperature (SST) patterns are recognized as major feedbacks affecting climate sensitivity to increases in greenhouse gases. Over recent decades, while most of Earth’s surface warmed, the eastern tropical Pacific and Southern Ocean unexpectedly cooled. These regional SST cooling trends are not quantitatively reproduced in global climate models (GCMs), contributing to biases in estimates of effective climate sensitivity. Although Antarctic ozone depletion has been proposed as a potential driver, its influence has generally been considered too weak to account for the observed cooling, in part because poorly constrained long-timescale ocean adjustment in GCMs can offset the initial cooling response. Here, we exploit internally generated interannual variability in Antarctic total-column ozone and global SST using a multiple linear regression model trained on ~4,000 years of unforced control simulations from eight GCMs. This approach isolates the robust short-timescale coupling between Antarctic ozone and SST while minimizing the influence of highly uncertain long-timescale ocean adjustment. Although this estimate represents a physically motivated upper bound on ozone’s contribution, the inferred ozone-driven SST closely resembles observations in both spatial pattern and magnitude. Using a Green’s function approach, we estimate that this ozone-driven SST pattern effect can make global radiative feedback more negative by 8-19\% (0.2-0.7 W/m^2K) during 1979-2000, the period of most rapid ozone depletion, thereby reducing effective climate sensitivity. As Antarctic ozone recovery began in the 2000s, this pattern effect started to wane, reducing its stabilizing influence on global radiative feedback and increasing effective climate sensitivity.},
	journal = {Proceedings of the National Academy of Sciences (under review)},
	abbr = {Article},
	author = {Wang, Peidong and Solomon, Susan and Deser, Clara and Thompson, David W. J. and Diffenbaugh, Noah S.},
	corresponding = {Wang, Peidong},
	year = {2026},
}
